PORT=3001
# Shared secret — must exactly match TENDER_API_KEY in the backend (.env).
# The backend refuses to sync and the tender website rejects every request
# until a strong random key is configured on both sides (e.g. `openssl rand -hex 32`).
TENDER_API_KEY=tndr_replace-with-a-strong-random-key
# Live backend feed (Postgres + AWS S3). The portal pulls real-time tenders
# from BACKEND_URL/api/v1/public/tenders and falls back to the local sync
# cache when the backend is unreachable.
BACKEND_URL=http://localhost:4000
