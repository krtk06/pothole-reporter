# ─────────────────────────────────────────────────────────────
# Tender portal — server-side configuration
# ALL of these are read in Node (src/lib/*), never inlined into the
# browser bundle. Do NOT prefix any of them with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Live backend feed. The portal pulls GET /api/v1/public/tenders from
# BACKEND_URL and falls back to the local sync cache when unreachable.
BACKEND_URL=http://localhost:4000

# Shared secret — must exactly match TENDER_API_KEY on the backend.
# The backend refuses to sync and this portal rejects every ingest
# (401) until a strong random key is set on both sides.
# Generate with: openssl rand -hex 32
TENDER_API_KEY=tndr_replace-with-a-strong-random-key

# ─── AWS S3 tender store ──────────────────────────────────────
# MANDATORY when deployed to Vercel. Vercel's filesystem (/var/task)
# is READ-ONLY, so without a bucket the JSON store falls back to
# fs.writeFileSync, throws EROFS, and every /api/* route returns 500.
# Locally the disk fallback is fine, so leave these blank for `npm run dev`.
#
# AWS_REGION only needs to match the bucket's region.
AWS_REGION=us-east-1
TENDER_STORE_BUCKET=
TENDER_STORE_KEY=tender-portal/tenders.json

# Vercel has no instance profile / IMDS role, so a static IAM user key
# pair IS required here (unlike on EC2). Scope it as narrowly as
# possible — the app only ever touches one object key:
#
#   { "Effect":"Allow",
#     "Action":["s3:GetObject","s3:PutObject"],
#     "Resource":"arn:aws:s3:::<TENDER_STORE_BUCKET>/tender-portal/*" }
#
# These must NOT be the backend's credentials — that principal also
# writes pothole evidence photos and sends SES mail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# NOTE: PORT is intentionally absent. The port is hardcoded in the
# npm scripts (`next dev -p 3001` / `next start -p 3001`); declaring
# PORT here has never had any effect.