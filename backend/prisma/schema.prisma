generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  public
  admin
}

enum ThemePreference {
  light
  dark
}

enum ReportStatus {
  pending
  verified
  rejected
  fixed
}

enum TenderStatus {
  open
  assigned
  completed
  rejected
}

enum RoadIssueStatus {
  active
  fixed
  dismissed
}

enum DeduplicationState {
  new
  reused
  not_an_issue
}

model User {
  id               String          @id @default(uuid()) @db.Uuid
  role             Role            @default(public)
  name             String          @db.VarChar(255)
  email            String?         @unique @db.VarChar(255)
  phone            String?         @unique @db.VarChar(20)
  state            String?         @db.VarChar(120)
  district         String?         @db.VarChar(120)
  // Kept as `locality` for backwards compatibility with the live database.
  // The API exposes this value as `mandal`.
  locality         String?         @db.VarChar(160)
  admin_scope      String?         @db.VarChar(32)
  password_hash    String          @db.VarChar(255)
  theme_preference ThemePreference @default(dark)
  refresh_token    String?         @db.Text
  session_version  Int             @default(0)
  created_at       DateTime        @default(now())
  potholes         Pothole[]
  password_reset_tokens PasswordResetToken[]
  sessions         UserSession[]

  @@index([admin_scope])
  @@index([role])
  @@map("users")
}

model UserSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @unique @db.VarChar(64)
  user_agent         String?   @db.VarChar(512)
  ip_address         String?   @db.VarChar(64)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at       DateTime? @db.Timestamptz(6)
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("user_sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model Pothole {
  id           String       @id @default(uuid()) @db.Uuid
  reporter_id  String       @db.Uuid
  image_s3_key String       @db.VarChar(255)
  report_type  String       @default("single") @db.VarChar(20)
  evidence_metadata Json?
  canonical_issue_id String?    @db.Uuid
  deduplication_state DeduplicationState @default(new)
  ai_result          Json?
  location     Unsupported("geometry(Point, 4326)")
  address_notes String?     @db.Text
  block_id     String?      @db.VarChar(100)
  status       ReportStatus @default(pending)
  created_at   DateTime     @default(now())
  reporter     User         @relation(fields: [reporter_id], references: [id])
  canonical_issue RoadIssue? @relation(fields: [canonical_issue_id], references: [id])

  @@index([reporter_id])
  @@index([block_id])
  @@index([status])
  @@index([created_at(sort: Desc)])
  @@index([canonical_issue_id])
  @@map("potholes")
}

model RoadIssue {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  condition         String    @db.VarChar(64)
  location          Unsupported("geometry(Point, 4326)")
  block_id          String?   @db.VarChar(100)
  severity_score    Decimal?  @db.Decimal(5, 2)
  pothole_count     Int       @default(1)
  confidence        Decimal?  @db.Decimal(5, 4)
  status            RoadIssueStatus @default(active)
  model_version     String?   @db.VarChar(128)
  analysis          Json?
  evidence_count    Int       @default(1)
  first_detected_at DateTime  @default(now())
  last_detected_at  DateTime  @default(now())
  reports           Pothole[]

  @@index([status, last_detected_at(sort: Desc)], map: "road_issues_active_recent_idx")
  @@index([block_id])
  @@map("road_issues")
}

model Tender {
  id            String       @id @default(uuid()) @db.Uuid
  block_id      String       @db.VarChar(100)
  pothole_count Int
  estimated_cost Decimal @db.Decimal(10, 2)
  status        TenderStatus @default(open)
  generated_at  DateTime     @default(now())

  @@index([block_id, status])
  @@map("tenders")
}

model AdministrativeArea {
  id               String   @id @db.VarChar(64)
  name             String   @db.VarChar(255)
  normalized_name  String   @db.VarChar(255)
  level            String   @db.VarChar(24)
  state_code       String?  @db.VarChar(32)
  state_name       String?  @db.VarChar(255)
  district_code    String?  @db.VarChar(32)
  district_name    String?  @db.VarChar(255)
  subdistrict_code String?  @db.VarChar(32)
  subdistrict_name String?  @db.VarChar(255)
  latitude         Decimal? @db.Decimal(9, 6)
  longitude        Decimal? @db.Decimal(9, 6)
  bbox             Json?
  boundary         Json?
  updated_at       DateTime @default(now()) @updatedAt

  @@index([level, state_name, normalized_name], map: "administrative_areas_level_state_name_normalized_name_idx")
  @@index([level, state_name, district_name, normalized_name], map: "administrative_areas_level_state_name_district_name_normalized_")
  @@index([level, state_name, district_name, subdistrict_name, normalized_name], map: "administrative_areas_level_state_name_district_name_subdistrict")
  @@map("administrative_areas")
}

// Tender website periodic-sync settings. Previously created at runtime; these
// are now explicit migrations so a fresh deployment is complete.
model tender_sync_settings {
  id                  String    @id @db.VarChar(50)
  target_url          String    @default("http://localhost:3001/api/sync") @db.Text
  api_key             String    @default("") @db.VarChar(255)
  sync_interval_days  Int       @default(15)
  is_enabled          Boolean   @default(true)
  last_sync_at        DateTime? @db.Timestamptz(6)
  next_sync_at        DateTime? @db.Timestamptz(6)
  last_sync_status    String?   @default("idle") @db.VarChar(50)
  last_sync_message   String?   @db.Text
  sync_lock_until     DateTime? @db.Timestamptz(6)
  consecutive_failures Int      @default(0)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
}

model tender_sync_logs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  synced_at       DateTime @default(now()) @db.Timestamptz(6)
  potholes_count  Int      @default(0)
  tenders_count   Int      @default(0)
  status          String   @db.VarChar(50)
  response_status Int?
  error_message   String?  @db.Text
  triggered_by    String   @default("scheduler") @db.VarChar(255)

  @@index([synced_at(sort: Desc)])
}
