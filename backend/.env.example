# ── Database: AWS RDS PostgreSQL with PostGIS ─────────────
# This backend is AWS-only. It refuses to start unless DATABASE_URL points at
# an RDS endpoint (src/config/databaseTarget.ts).
#
# Use a separate database on the same RDS instance for development:
#   CREATE DATABASE pothole_dev;
# Migrations enable PostGIS themselves.
DATABASE_URL="postgresql://<user>:<password>@<instance>.<region>.rds.amazonaws.com:5432/pothole?schema=public"
# Local PostGIS database for tests only. Leave unset in production.
# DATABASE_ALLOW_LOCAL=1

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_RESET_SECRET="replace-with-a-third-long-random-secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# ── AWS (S3 + SES) ─────────────────────────────────────────
AWS_REGION="ap-southeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="pothole-evidence-capstone"
SES_FROM_EMAIL=""

# ── App ────────────────────────────────────────────────────
ML_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"
POTHOLE_TENDER_THRESHOLD="20"
TENDER_COST_PER_POTHOLE="15000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="https://main.example.com,https://tender.example.com"
PORT="4000"
LOG_LEVEL="info"

# One resolved uploads directory for local storage. In production prefer S3.
# If local storage is used, this must be on a persistent EBS volume.
UPLOADS_DIR=""

# ── AI worker (internal VPC) ───────────────────────────────
# Must include the API prefix because the code appends /detect/image.
AI_SERVICE_URL="http://172.31.26.131:8001/api/v1"
AI_SERVER_API_KEY=""
AI_REQUEST_TIMEOUT_MS="180000"
ROAD_ISSUE_DEDUP_RADIUS_METERS="15"
BLOCK_RESOLUTION_MAX_METERS="75000"

# Trust reverse-proxy headers (X-Forwarded-For / X-Forwarded-Proto).
# Leave unset unless a proxy you control terminates the connection and
# overwrites those headers. Rate limiting keys on the derived client IP.
#   true | false | <hop count> | loopback,linklocal,uniquelocal
# If the Next.js rewrite/Vercel/ALB proxy is in front of this backend, set 1
# so rate limiting sees the real client. Leave empty when port 4000 is direct.
TRUST_PROXY=1

# ── Tender website integration ─────────────────────────────
TENDER_API_KEY=""
TENDER_WEBSITE_URL="http://localhost:3001/api/sync"
# Only for local development. Never enable against a production target.
ALLOW_PRIVATE_TENDER_URL="0"
