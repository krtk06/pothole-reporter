DATABASE_URL="postgresql://user:password@localhost:5432/pothole_db?schema=public"
JWT_SECRET="replace-with-a-secure-random-string"
JWT_REFRESH_SECRET="replace-with-another-secure-random-string"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="your-pothole-bucket"
S3_BUCKET_ARN="arn:aws:s3:::your-pothole-bucket/*"
ML_WEBHOOK_SECRET="ml-internal-api-key"
POTHOLE_TENDER_THRESHOLD="20"
FRONTEND_URL="http://localhost:3000"
PORT="4000"
