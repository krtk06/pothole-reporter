# ── Supabase (PostgreSQL) ──────────────────────────────────
# Direct connection (recommended for Prisma):
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# Pooled connection (via Supabase's PgBouncer — add ?pgbouncer=true):
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres"

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET="replace-with-a-secure-random-string"
JWT_REFRESH_SECRET="replace-with-another-secure-random-string"
JWT_RESET_SECRET="replace-with-a-third-secure-random-string"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# ── AWS (S3 + SES) ─────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="your-pothole-bucket"
SES_FROM_EMAIL="noreply@pothole-reporter.com"

# ── App ────────────────────────────────────────────────────
ML_WEBHOOK_SECRET="ml-internal-api-key"
POTHOLE_TENDER_THRESHOLD="5"
FRONTEND_URL="http://localhost:3000"
PORT="4000"
LOG_LEVEL="info"
